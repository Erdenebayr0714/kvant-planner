# --- Өгөгдлийн сангийн холболт (Neon-оос авсан connection string) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Нэвтрэлтийн нууц түлхүүр (санамсаргүй урт тэмдэгт) ---
# Жишээ болгож дараах командаар үүсгэж болно:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=энд_санамсаргүй_урт_тэмдэгт_тавина

# --- Эхний админ хэрэглэгч (зөвхөн анх удаа өгөгдлийн сан хоосон үед үүснэ) ---
ADMIN_USER=admin
ADMIN_PASSWORD=Kvant2026!

# --- Production горим (хостинг дээр production гэж тавина) ---
NODE_ENV=production
